PORT=8888

# SQLite
DB_PATH=../database/campus_rpg.sqlite

# CORS: leave empty in development to allow all origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth
# Use a long random string in your local .env.
JWT_SECRET=replace-with-a-long-random-secret

# LLM quest generation
GEMINI_API_KEY=your-google-ai-studio-api-key
# GEMINI_API_KEY=your_google_ai_studio_key
# Or use GOOGLE_API_KEY instead of GEMINI_API_KEY.
# GEMINI_MODEL=gemini-2.5-flash

# Kakao OAuth
# Keep these values in backend/.env only. Do not expose KAKAO_CLIENT_SECRET to the frontend.
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:5173/kakao
